# ==============================
# Makong Network Website - Environment
# Copy this file to ".env" and fill in the real values.
# NEVER commit your real ".env" file.
# ==============================

# Port the website runs on
PORT=3000

# Which address to bind. Leave unset (0.0.0.0) for local development. Behind a
# Cloudflare Tunnel or nginx, set HOST=127.0.0.1 so the site is reachable only
# through the proxy and never on the machine's public IP.
# HOST=127.0.0.1

# Public base URL of this website. Used for absolute links (e.g. in Telegram
# messages) AND to decide whether to trust proxy headers and mark the session
# cookies Secure - so in production this MUST be your real https:// address.
SITE_URL=http://localhost:3000

# --- Admin Panel (built-in web admin at /admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Random long string used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Telegram Bot (order notifications + optional admin item management) ---
# Create a bot with @BotFather on Telegram to get a token
TELEGRAM_BOT_TOKEN=
# Your personal Telegram numeric user ID (message @userinfobot to get it).
# Purchase notifications AND /additem etc. admin commands are restricted to this ID.
TELEGRAM_ADMIN_CHAT_ID=
# Public @username shown to customers for support (without the @)
TELEGRAM_SUPPORT_USERNAME=MakongSupport

# --- MakongCore plugin bridge (optional, see ../MakongCore/README.md) ---
# MAKONGCORE_SECRET is the one shared secret for the whole bridge - it must
# match `website.secret` in every MakongCore plugin's config.yml exactly (the
# same value on the Paper plugin on each backend server AND the Velocity
# plugin on the proxy). Leave it empty and the site runs standalone: names are
# accepted on their own, and the admin "Servers" page + auto-delivery on
# Accept simply show no servers connected.
MAKONGCORE_SECRET=
# Only used for the older, separate player-verify API (live coins/rank lookup
# against a single plugin HTTP server) - not required for the plugin bridge
# above, which needs only the shared secret since plugins connect outward to
# this website instead. Leave empty unless you're running that too.
MAKONGCORE_URL=

# --- Tebex Headless API (optional card/wallet payments, see README's "Purchase
# flow" section) ---
# When set, items with a "Tebex package ID" (set per-item in the admin panel)
# show a "Pay via Tebex" button on /checkout alongside KHQR - the customer pays
# on Tebex's own hosted checkout and is brought straight back, confirmed
# automatically. Leave empty and only KHQR + manual review is offered.
# Get this from the Tebex Creator Panel: Webstore -> Integrations -> Headless API.
TEBEX_WEBSTORE_TOKEN=
