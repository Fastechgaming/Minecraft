<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= entry ? "Edit" : "Add" %> Ranking Entry · Admin</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
  <header class="admin-header">
    <h1><%= entry ? "Edit" : "Add" %> <%= category === "teams" ? "team" : "player" %></h1>
    <a class="btn-ghost" href="/admin/rankings">Back to list</a>
  </header>

  <main class="admin-main">
    <form class="admin-form" method="POST" action="<%= entry ? '/admin/rankings/' + entry.id : '/admin/rankings' %>">
      <% if (!entry) { %>
        <input type="hidden" name="category" value="<%= category %>" />
      <% } %>

      <label>Name
        <input type="text" name="name" value="<%= entry ? entry.name : '' %>" required />
      </label>

      <label>Icon (emoji, optional)
        <input type="text" name="icon" value="<%= entry ? (entry.icon || '') : '' %>" placeholder="🛕" maxlength="4" />
        <small style="font-weight:400; color:#7a7060;">Shown instead of the name's first letter. Leave blank to use the initial.</small>
      </label>

      <label>Star
        <input type="number" step="1" min="0" name="star" value="<%= entry ? entry.star : 0 %>" required />
        <% if (category === "players") { %>
          <small style="font-weight:400; color:#7a7060;">Also sets this player's rank tier on the Ranking page: M9 at 0, M8 at 150, M7 at 300, M6 at 450, M5 at 600, M4 at 750, M3 at 975, M2 at 1,200, M1 at 1,500+ (M1 is limited to the top 10 in the MakongCore plugin, but not enforced here - this admin list has no such cap).</small>
        <% } %>
      </label>

      <button class="btn" type="submit"><%= entry ? "Save changes" : "Add entry" %></button>
    </form>
  </main>
</body>
</html>
