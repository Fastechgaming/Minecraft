// MakongOS — Prisma schema (v2 full rewrite)
// One schema backs the bot, the dashboard API, and every feature module.
// Single process, single database — no external services required.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Core: Guild / Users / Members
// ─────────────────────────────────────────────────────────────────────────

model Guild {
  id        String   @id // Discord guild ID
  name      String
  icon      String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings          GuildSettings?
  members           Member[]
  dashboardAccess   DashboardAccess[]
  moderationCases   ModerationCase[]
  warnings          Warning[]
  tempRoles         TempRole[]
  xpEntries         XP[]
  economyProfiles   EconomyProfile[]
  shopItems         ShopItem[]
  tempVoiceChannels TempVoiceChannel[]
  giveaways         Giveaway[]
  reactionRolePanels ReactionRolePanel[]
  socialAlerts      SocialAlert[]
  serverBackups     ServerBackup[]
  knowledgeEntries  KnowledgeBase[]
  aiConversations   AIConversation[]
  aiMemories        AIMemory[]
  aiEscalations     AIEscalation[]
  aiUsage           AIUsage[]
  auditLogs         AuditLog[]
  commandConfigs    CommandConfig[]

  @@map("guilds")
}

model GuildSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  // ── Feature toggles ──────────────────────────────────────────────────
  moderationEnabled  Boolean @default(true)
  antiScamEnabled    Boolean @default(true)
  musicEnabled       Boolean @default(true)
  levelingEnabled    Boolean @default(true)
  economyEnabled     Boolean @default(true)
  voiceHubEnabled    Boolean @default(false)
  giveawaysEnabled   Boolean @default(true)
  reactionRolesEnabled Boolean @default(true)
  socialAlertsEnabled Boolean @default(true)
  aiEnabled          Boolean @default(true)

  // ── General ───────────────────────────────────────────────────────────
  prefix        String  @default("!")
  logChannelId  String?
  staffRoleIds  String[] @default([])
  adminRoleIds  String[] @default([])

  // ── Moderation / Automod ────────────────────────────────────────────
  automodBlockInvites   Boolean  @default(true)
  automodBlockBadWords  Boolean  @default(true)
  automodBadWords       String[] @default([])
  automodBlockSpam      Boolean  @default(true)
  automodSpamMsgCount   Int      @default(5)
  automodSpamWindowSec  Int      @default(6)
  automodBlockGhostPing Boolean  @default(true)
  automodWhitelistRoleIds    String[] @default([])
  automodWhitelistChannelIds String[] @default([])
  modLogChannelId       String?
  warningDecayDays      Int      @default(30)

  // ── AI Anti-Scam ─────────────────────────────────────────────────────
  antiScamAction        String   @default("timeout") // timeout | kick | ban
  antiScamTimeoutMin    Int      @default(60)
  antiScamWhitelistRoleIds    String[] @default([])
  antiScamWhitelistChannelIds String[] @default([])

  // ── AI Assistant ─────────────────────────────────────────────────────
  aiChatChannelIds  String[] @default([])
  aiMode            String   @default("hybrid") // staff | friend | hybrid
  aiPersonality     String?
  aiEscalationChannelId String?
  aiConfidenceThreshold Float @default(0.6)

  // ── Leveling ──────────────────────────────────────────────────────────
  xpPerMessage     Int @default(15)
  xpCooldownSec    Int @default(60)
  xpPerVoiceMin    Int @default(10)
  xpLevelUpBase    Int @default(100)
  levelUpChannelId String?
  levelRoleRewards Json  @default("[]") // [{level:number, roleId:string}]

  // ── Economy ───────────────────────────────────────────────────────────
  economyCurrencyName    String @default("Coins")
  economyCurrencySymbol  String @default("🪙")
  economyDailyAmount     Int    @default(250)
  economyWorkMin         Int    @default(50)
  economyWorkMax         Int    @default(200)
  economyRobEnabled      Boolean @default(true)
  economyRobSuccessRate  Float   @default(0.4)

  // ── Join-to-Create Voice Hub ─────────────────────────────────────────
  voiceHubSetupChannelId String?
  voiceHubCategoryId     String?
  voiceHubDefaultName    String  @default("{user}'s Channel")
  voiceHubDefaultLimit   Int     @default(0)

  // ── Welcome / Leave ──────────────────────────────────────────────────
  welcomeEnabled   Boolean @default(false)
  welcomeChannelId String?
  welcomeMessage   String  @default("Welcome {user} to {server}!")
  leaveEnabled     Boolean @default(false)
  leaveChannelId   String?
  leaveMessage     String  @default("{user} has left {server}.")
  autoRoleIds      String[] @default([])

  // ── Music ─────────────────────────────────────────────────────────────
  musicMaxQueue    Int @default(200)
  musicDefaultVol  Int @default(100)
  musicDjRoleIds   String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_settings")
}

model DashboardAccess {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId  String
  role    String @default("viewer") // viewer | support | dj | moderator | ai_manager | administrator | owner

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@map("dashboard_access")
}

model User {
  id            String   @id // Discord user ID
  username      String
  discriminator String?
  avatar        String?
  isBotOwner    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members         Member[]
  economyProfiles EconomyProfile[]
  aiMemories      AIMemory[]

  @@map("users")
}

model Member {
  id       String @id @default(cuid())
  guildId  String
  guild    Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
  @@map("members")
}

// ─────────────────────────────────────────────────────────────────────────
// Moderation
// ─────────────────────────────────────────────────────────────────────────

model ModerationCase {
  id         String   @id @default(cuid())
  guildId    String
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  caseNumber Int
  type       String   // warn | timeout | kick | ban | unban | untimeout | antiscam
  targetId   String
  targetTag  String
  moderatorId String
  moderatorTag String
  reason     String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId])
  @@map("moderation_cases")
}

model Warning {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  reason    String?
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([guildId, userId])
  @@map("warnings")
}

model TempRole {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  roleId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([guildId, expiresAt])
  @@map("temp_roles")
}

// ─────────────────────────────────────────────────────────────────────────
// Leveling
// ─────────────────────────────────────────────────────────────────────────

model XP {
  id           String @id @default(cuid())
  guildId      String
  guild        Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId       String
  textXp       Int    @default(0)
  voiceXp      Int    @default(0)
  lastMessageAt DateTime?
  lastVoiceTickAt DateTime?

  @@unique([guildId, userId])
  @@index([guildId, textXp])
  @@map("xp")
}

// ─────────────────────────────────────────────────────────────────────────
// Economy
// ─────────────────────────────────────────────────────────────────────────

model EconomyProfile {
  id            String   @id @default(cuid())
  guildId       String
  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Int      @default(0)
  bank          Int      @default(0)
  dailyStreak   Int      @default(0)
  lastDailyAt   DateTime?
  lastWorkAt    DateTime?
  lastRobAt     DateTime?

  inventory     InventoryItem[]

  @@unique([guildId, userId])
  @@index([guildId, wallet])
  @@map("economy_profiles")
}

model ShopItem {
  id          String  @id @default(cuid())
  guildId     String
  guild       Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  description String?
  price       Int
  roleId      String?
  emoji       String  @default("📦")
  stock       Int?    // null = unlimited

  inventoryEntries InventoryItem[]

  @@map("shop_items")
}

model InventoryItem {
  id        String   @id @default(cuid())
  profileId String
  profile   EconomyProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  acquiredAt DateTime @default(now())

  @@unique([profileId, itemId])
  @@map("inventory_items")
}

// ─────────────────────────────────────────────────────────────────────────
// Join-to-Create Voice Hub
// ─────────────────────────────────────────────────────────────────────────

model TempVoiceChannel {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  @@map("temp_voice_channels")
}

// ─────────────────────────────────────────────────────────────────────────
// Giveaways & Reaction Roles
// ─────────────────────────────────────────────────────────────────────────

model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String
  messageId   String?
  prize       String
  winnerCount Int      @default(1)
  hostId      String
  requiredRoleId String?
  entrantIds  String[] @default([])
  winnerIds   String[] @default([])
  endsAt      DateTime
  ended       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([guildId, ended, endsAt])
  @@map("giveaways")
}

model ReactionRolePanel {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  messageId String?
  title     String   @default("Roles")
  style     String   @default("dropdown") // dropdown | buttons
  options   Json     @default("[]") // [{roleId:string, label:string, emoji:string}]
  createdAt DateTime @default(now())

  @@map("reaction_role_panels")
}

// ─────────────────────────────────────────────────────────────────────────
// Social Alerts (Twitch / YouTube)
// ─────────────────────────────────────────────────────────────────────────

model SocialAlert {
  id             String   @id @default(cuid())
  guildId        String
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  platform       String   // twitch | youtube
  channelHandle  String   // twitch login or youtube channel id
  announceChannelId String
  message        String   @default("{creator} is now live! {url}")
  lastSeenId     String?  // last stream/video id announced, for dedupe
  createdAt      DateTime @default(now())

  @@unique([guildId, platform, channelHandle])
  @@map("social_alerts")
}

// ─────────────────────────────────────────────────────────────────────────
// Server Backups
// ─────────────────────────────────────────────────────────────────────────

model ServerBackup {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  data      Json     // { roles: [...], channels: [...] }
  createdById String
  createdAt DateTime @default(now())

  @@map("server_backups")
}

// ─────────────────────────────────────────────────────────────────────────
// AI Staff Assistant
// ─────────────────────────────────────────────────────────────────────────

model KnowledgeBase {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  category  String   @default("general")
  addedById String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId])
  @@map("knowledge_base")
}

model AIConversation {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  channelId String
  role      String   // user | model
  content   String
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@map("ai_conversations")
}

model AIMemory {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fact      String
  createdAt DateTime @default(now())

  @@index([guildId, userId])
  @@map("ai_memories")
}

model AIEscalation {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  question    String
  channelId   String
  messageId   String?
  resolved    Boolean  @default(false)
  answeredById String?
  answer      String?
  createdAt   DateTime @default(now())

  @@map("ai_escalations")
}

model AIUsage {
  id           String   @id @default(cuid())
  guildId      String
  guild        Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  chatMessages Int      @default(0)
  imagesGenerated Int   @default(0)
  scansPerformed  Int   @default(0)
  escalations  Int      @default(0)

  @@unique([guildId, date])
  @@map("ai_usage")
}

// ─────────────────────────────────────────────────────────────────────────
// Command Config, Audit Log, Premium Vouchers
// ─────────────────────────────────────────────────────────────────────────

model CommandConfig {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name      String
  enabled   Boolean  @default(true)
  allowedRoleIds String[] @default([])
  allowedChannelIds String[] @default([])

  @@unique([guildId, name])
  @@map("command_configs")
}

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type      String   // moderation | command | ai | error | member_join | member_leave | giveaway | economy | voice_hub
  actorId   String?
  summary   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId, type, createdAt])
  @@map("audit_logs")
}

model PremiumVoucher {
  id        String   @id @default(cuid())
  code      String   @unique
  plan      String   @default("premium")
  redeemedByGuildId String?
  redeemedAt DateTime?
  createdById String
  createdAt DateTime @default(now())

  @@map("premium_vouchers")
}
