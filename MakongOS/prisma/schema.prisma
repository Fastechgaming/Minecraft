// MakongOS — Prisma schema
// One schema backs the bot, the dashboard API, and every feature module.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Core: Guild / Users / Members
// ─────────────────────────────────────────────────────────────────────────

model Guild {
  id        String   @id // Discord guild ID
  name      String
  icon      String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings         GuildSettings?
  members          Member[]
  tickets          Ticket[]
  ticketPanels     TicketPanel[]
  aiConversations  AIConversation[]
  aiMemories       AIMemory[]
  knowledgeEntries KnowledgeBase[]
  commandConfigs   CommandConfig[]
  xpEntries        XP[]
  musicSessions    MusicSession[]
  auditLogs        AuditLog[]
  aiUsage          AIUsage[]
  aiEscalations    AIEscalation[]
  dashboardAccess  DashboardAccess[]
  economyProfiles  EconomyProfile[]
  suggestions      Suggestion[]
  giveaways        Giveaway[]

  @@map("guilds")
}

model GuildSettings {
  id      String @id @default(cuid())
  guildId String @unique
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  prefix     String @default("!")
  language   String @default("en")
  timezone   String @default("UTC")
  embedColor String @default("#5865F2")

  // Channels
  logChannelId        String?
  aiEscalationChannel String?
  suggestionsChannelId String?
  ticketLogChannelId  String?
  aiChannelIds        String[] @default([])
  musicChannelIds     String[] @default([])

  // Roles
  staffRoleIds String[] @default([])
  adminRoleIds String[] @default([])
  djRoleIds    String[] @default([])

  // Feature toggles
  aiEnabled          Boolean @default(true)
  musicEnabled       Boolean @default(true)
  ticketsEnabled     Boolean @default(true)
  economyEnabled     Boolean @default(true)
  funEnabled         Boolean @default(true)
  suggestionsEnabled Boolean @default(true)
  giveawaysEnabled   Boolean @default(true)
  levelingEnabled    Boolean @default(true)

  // AI behavior
  aiMode                  String  @default("staff") // staff | moderator | friend | hybrid
  aiResponseFrequency     String  @default("normal") // low | normal | high
  aiMentionRequired       Boolean @default(true)
  aiHelpDetection         Boolean @default(true)
  aiCasualConversation    Boolean @default(false)
  aiStaffEscalation       Boolean @default(true)
  aiMemoryEnabled         Boolean @default(true)
  aiMemoryDurationHours   Int     @default(720)
  aiMaxHistoryMessages    Int     @default(12)
  aiImageUnderstanding    Boolean @default(true)
  aiImageGeneration       Boolean @default(false)
  aiDailyLimit            Int     @default(500)
  aiMonthlyLimit          Int     @default(10000)
  aiPerUserCooldownSec    Int     @default(8)
  aiPerChannelCooldownSec Int     @default(2)

  // XP / leveling
  xpPerMessage  Int @default(5)
  xpCooldownSec Int @default(60)
  xpPerVoiceMin Int @default(2)
  xpLevelUpBase Int @default(100)

  // Music
  musicMaxQueue   Int @default(200)
  musicDefaultVol Int @default(80)

  // Tickets
  ticketMaxOpenPerUser Int @default(2)

  // Economy
  economyCurrencySymbol String @default("🪙")
  economyDailyAmount    Int    @default(100)
  economyBegMin         Int    @default(10)
  economyBegMax         Int    @default(150)
  economyBegCooldownSec Int    @default(21600)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_settings")
}

model DashboardAccess {
  id      String @id @default(cuid())
  guildId String
  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId  String
  role    String @default("viewer") // owner | administrator | support | dj | ai_manager | viewer

  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@map("dashboard_access")
}

model User {
  id            String   @id // Discord user ID
  username      String?
  discriminator String?
  avatar        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships Member[]
  aiMemories  AIMemory[]

  @@map("users")
}

model Member {
  id       String    @id @default(cuid())
  guildId  String
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([guildId, userId])
  @@index([guildId])
  @@map("members")
}

// ─────────────────────────────────────────────────────────────────────────
// Economy + Social
// ─────────────────────────────────────────────────────────────────────────

model EconomyProfile {
  id          String    @id @default(cuid())
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String
  coins       Int       @default(0)
  bank        Int       @default(0)
  dailyStreak Int       @default(0)
  lastDailyAt DateTime?
  lastBegAt   DateTime?
  repGiven    Int       @default(0)
  repReceived Int       @default(0)
  lastRepAt   DateTime?

  @@unique([guildId, userId])
  @@index([guildId, coins])
  @@index([guildId, repReceived])
  @@map("economy_profiles")
}

// ─────────────────────────────────────────────────────────────────────────
// Tickets
// ─────────────────────────────────────────────────────────────────────────

model TicketPanel {
  id          String           @id @default(cuid())
  guildId     String
  guild       Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name        String
  channelId   String?
  messageId   String?
  title       String           @default("🎫 Support Center")
  description String           @default("What do you need help with?")
  color       String           @default("#5865F2")
  categories  TicketCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([guildId])
  @@map("ticket_panels")
}

model TicketCategory {
  id                String      @id @default(cuid())
  panelId           String
  panel             TicketPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  label             String
  emoji             String?
  description       String?
  discordCategoryId String?
  staffRoleIds      String[]    @default([])
  order             Int         @default(0)

  tickets Ticket[]

  @@index([panelId])
  @@map("ticket_categories")
}

model Ticket {
  id           String          @id @default(cuid())
  guildId      String
  guild        Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     TicketCategory? @relation(fields: [categoryId], references: [id])
  number       Int
  channelId    String          @unique
  openerId     String
  claimedById  String?
  status       String          @default("open") // open | claimed | closed
  transcript   String?
  closedById   String?
  closedReason String?
  createdAt    DateTime        @default(now())
  closedAt     DateTime?

  @@unique([guildId, number])
  @@index([guildId, status])
  @@map("tickets")
}

// ─────────────────────────────────────────────────────────────────────────
// Suggestions
// ─────────────────────────────────────────────────────────────────────────

model Suggestion {
  id           String    @id @default(cuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String
  messageId    String    @unique
  userId       String
  content      String
  status       String    @default("pending") // pending | approved | rejected
  upvotes      Int       @default(0)
  downvotes    Int       @default(0)
  reviewedById String?
  reviewReason String?
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?

  @@index([guildId, status])
  @@map("suggestions")
}

// ─────────────────────────────────────────────────────────────────────────
// Giveaways
// ─────────────────────────────────────────────────────────────────────────

model Giveaway {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId   String
  messageId   String   @unique
  prize       String
  winnerCount Int      @default(1)
  hostedById  String
  entrantIds  String[] @default([])
  winnerIds   String[] @default([])
  endsAt      DateTime
  ended       Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([guildId, ended, endsAt])
  @@map("giveaways")
}

// ─────────────────────────────────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────────────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  userId    String
  role      String   // user | assistant | system
  content   String
  imageUrls String[] @default([])
  mode      String   @default("staff")
  createdAt DateTime @default(now())

  @@index([guildId, channelId, userId, createdAt])
  @@map("ai_conversations")
}

model AIMemory {
  id        String    @id @default(cuid())
  guildId   String
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([guildId, userId, key])
  @@index([guildId, userId])
  @@map("ai_memories")
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  guildId   String
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  category  String   // rules | faq | minecraft | commands | ranks | store | events | staff | punishments | other
  title     String
  content   String
  keywords  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, category])
  @@map("knowledge_base")
}

model AIUsage {
  id               String   @id @default(cuid())
  guildId          String
  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  date             DateTime @default(now()) // truncated to day
  messagesAnalyzed Int      @default(0)
  responses        Int      @default(0)
  imageAnalyses    Int      @default(0)
  imagesGenerated  Int      @default(0)
  escalations      Int      @default(0)

  @@unique([guildId, date])
  @@map("ai_usage")
}

model AIEscalation {
  id           String    @id @default(cuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId       String
  channelId    String
  question     String
  reason       String
  transcript   String
  status       String    @default("pending") // pending | answered
  answeredById String?
  answer       String?
  createdAt    DateTime  @default(now())
  answeredAt   DateTime?

  @@index([guildId, status])
  @@map("ai_escalations")
}

// ─────────────────────────────────────────────────────────────────────────
// Command config / Audit / XP / Music
// ─────────────────────────────────────────────────────────────────────────

model CommandConfig {
  id                 String   @id @default(cuid())
  guildId            String
  guild              Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  commandName        String
  enabled            Boolean  @default(true)
  allowedRoleIds     String[] @default([])
  disabledChannelIds String[] @default([])
  cooldownSec        Int      @default(0)

  @@unique([guildId, commandName])
  @@map("command_configs")
}

model AuditLog {
  id          String   @id @default(cuid())
  guildId     String
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type        String   // ticket | command | ai | error | member_join | member_leave | suggestion | giveaway
  userId      String?
  moderatorId String?
  channelId   String?
  action      String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([guildId, type, createdAt])
  @@index([guildId, userId])
  @@map("audit_logs")
}

model XP {
  id            String    @id @default(cuid())
  guildId       String
  guild         Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId        String
  xp            Int       @default(0)
  level         Int       @default(0)
  lastMessageAt DateTime?
  lastVoiceAt   DateTime?

  @@unique([guildId, userId])
  @@index([guildId, xp])
  @@map("xp")
}

model MusicSession {
  id           String    @id @default(cuid())
  guildId      String
  guild        Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId    String
  startedById  String
  tracksPlayed Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  @@index([guildId])
  @@map("music_sessions")
}
