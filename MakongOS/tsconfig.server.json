{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/server.ts",
    "src/bot/**/*.ts",
    "src/ai/**/*.ts",
    "src/providers/**/*.ts",
    "src/database/**/*.ts",
    "src/services/**/*.ts",
    "src/utils/**/*.ts",
    "src/types/**/*.ts",
    "src/automation/**/*.ts",
    "src/minecraft/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app", "src/components", ".next"]
}
