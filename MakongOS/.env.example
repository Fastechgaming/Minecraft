# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ─── Discord Bot ─────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma separated guild IDs for instant (non-global) slash command registration in dev
DISCORD_DEV_GUILD_IDS=

# ─── Dashboard Auth (NextAuth) ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Comma separated Discord user IDs who always have owner-level dashboard access
BOT_OWNER_IDS=

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://makongos:makongos@localhost:5432/makongos?schema=public

# ─── AI (Gemini) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# ─── Minecraft (optional, configured per-server in dashboard too) ────────
MINECRAFT_DEFAULT_HOST=
MINECRAFT_DEFAULT_PORT=25565

# ─── Misc ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
