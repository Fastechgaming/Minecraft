# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ─── Discord Bot ─────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The bot auto-syncs slash commands to every guild it's in on every startup — no
# manual deploy step needed. This is only read by the optional `npm run
# deploy:commands` script: leave empty to force a one-off *global* rollout,
# or list specific guild IDs (comma separated) to target just those.
DISCORD_DEV_GUILD_IDS=

# ─── Dashboard Auth (NextAuth) ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Comma separated Discord user IDs who always have owner-level dashboard access
BOT_OWNER_IDS=

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://makongos:makongos@localhost:5432/makongos?schema=public

# ─── AI (Gemini) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
# gemini-3.5-flash-lite is the cheapest/fastest option (chat, vision, and the
# moderation classifier all use it) — swap to gemini-3.6-flash if you want
# noticeably stronger reasoning at higher cost/latency.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ─── Minecraft (optional, configured per-server in dashboard too) ────────
MINECRAFT_DEFAULT_HOST=
MINECRAFT_DEFAULT_PORT=25565

# ─── Misc ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
