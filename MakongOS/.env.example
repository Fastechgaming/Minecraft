# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000

# ─── Discord Bot ─────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# The bot auto-syncs slash commands to every guild it's in on every startup — no
# manual deploy step needed. This is only read by the optional `npm run
# deploy:commands` script: leave empty to force a one-off *global* rollout,
# or list specific guild IDs (comma separated) to target just those.
DISCORD_DEV_GUILD_IDS=

# ─── Dashboard Auth (NextAuth) ───────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# Comma separated Discord user IDs who always have owner-level dashboard access
BOT_OWNER_IDS=

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://makongos:makongos@localhost:5432/makongos?schema=public

# ─── AI (Gemini) ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
# gemini-3.5-flash-lite is the cheapest/fastest option (chat, the anti-scam
# vision scanner, and the AI staff assistant all use it) — swap to
# gemini-3.6-flash if you want noticeably stronger reasoning at higher
# cost/latency. /imagine uses the free, keyless Pollinations API instead —
# no image model or key needed here.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# ─── Music (Lavalink) ────────────────────────────────────────────────────
# Music playback runs through a local Lavalink server (a separate Java
# process managed by PM2 alongside the bot — see README's Music section and
# scripts/setup-lavalink.sh). These must match lavalink/application.yml.
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=replace-with-a-long-random-string

# YouTube requires proof-of-origin from datacenter IPs to allow streaming.
# Lavalink's youtube-plugin solves this via OAuth against a throwaway Google
# account — see README's Music section for the one-time device-code linking
# steps. Leave YOUTUBE_OAUTH_ENABLED=false to run without it (expect
# YouTube streams to be blocked on most VPS IPs).
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_REFRESH_TOKEN=

# ─── Social Alerts (optional) ────────────────────────────────────────────
# Leave any of these blank to disable that platform's live/upload alerts —
# the bot skips checks for a platform with no credentials rather than erroring.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=

# ─── Misc ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
